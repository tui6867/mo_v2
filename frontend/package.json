{
  "name": "outreach-mail-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:launch": "vite --config vite.launch.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:launch": "tsc --noEmit && vite build --config vite.launch.config.ts",
    "preview:launch": "vite preview --config vite.launch.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "test:launch:browser": "playwright test --config playwright.launch.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "border-beam": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
