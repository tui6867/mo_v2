# Template only. Copy into Community Cloud > Advanced settings > Secrets.
# Never commit .streamlit/secrets.toml. Blank credentials fail closed.
# Supabase publishable/anon key ONLY, never service-role or database password.
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
AUTH_REDIRECT_URL = ""
SENDER_EMAIL = ""
SENDER_DOMAIN_VERIFIED = false

# Suggested first-launch caps; match/tighten the authoritative database settings.
BATCH_LIMIT = 50
GLOBAL_HOURLY_LIMIT = 100
GLOBAL_DAILY_LIMIT = 300
MAX_ATTACHMENT_BYTES = 5242880
MAX_MESSAGE_BYTES = 10485760
MAX_CSV_BYTES = 1048576

# Leave disabled throughout setup and synthetic testing.
ENABLE_REAL_SENDS = false
SMTP_HOST = ""
SMTP_PORT = 465
SMTP_USERNAME = ""
SMTP_PASSWORD = ""
SMTP_TLS_MODE = "ssl"
SMTP_TIMEOUT_SECONDS = 30
