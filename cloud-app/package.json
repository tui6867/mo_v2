{
  "name": "mass-outreach-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "wrangler dev --cwd .. --config wrangler.jsonc",
    "deploy": "wrangler deploy --cwd .. --config wrangler.jsonc",
    "bundle:mcp": "node tools/bundle-mcp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": { "undici": "7.30.1" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@cloudflare/workers-types": "5.20261025.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.28.2",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
